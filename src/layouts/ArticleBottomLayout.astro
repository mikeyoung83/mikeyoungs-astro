---
import { type CollectionEntry, getCollection, render } from "astro:content";

type Props = {
    entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

// Get the requested entry
const { entry } = Astro.props;
const { collection } = entry;
const { Content } = await render(entry);

// Get the next and prev entries (modulo to wrap index)
const items = (await getCollection(collection))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const index = items.findIndex((x) => x.id === entry.id);
const prev = items[(index - 1 + items.length) % items.length];
const next = items[(index + 1) % items.length];
---

<div>
    <article>
        <Content />
    </article>
    <nav aria-label="More entries" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
            href={`/${prev.collection}/${prev.id}`}
            class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-base-content/5 dark:hover:bg-base-content/10 border-base-content/15 dark:border-base-content/20 blend"
        >
            <div
                class="order-2 w-full h-full group-hover:text-base-content blend"
            >
                <div class="flex flex-wrap gap-2">
                    <div class="text-sm uppercase">Prev</div>
                </div>
                <div class="font-semibold mt-3 text-base-content">
                    {prev.data.title}
                </div>
            </div>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="order-1 stroke-current group-hover:stroke-base-content rotate-180"
            >
                <line
                    x1="5"
                    y1="12"
                    x2="19"
                    y2="12"
                    class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
                ></line>
                <polyline
                    points="12 5 19 12 12 19"
                    class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
                ></polyline>
            </svg>
        </a>
        <a
            href={`/${next.collection}/${next.id}`}
            class="group p-4 gap-3 flex items-center border-2 rounded-lg hover:bg-base-content/5 dark:hover:bg-base-content/10 border-base-content/15 dark:border-base-content/20 transition-colors duration-300 ease-in-out"
        >
            <div
                class="w-full h-full text-right group-hover:text-base-content blend"
            >
                <div class="text-sm uppercase">Next</div>
                <div class="font-semibold mt-3 text-base-content">
                    {next.data.title}
                </div>
            </div>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="stroke-current group-hover:stroke-base-content"
            >
                <line
                    x1="5"
                    y1="12"
                    x2="19"
                    y2="12"
                    class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
                ></line>
                <polyline
                    points="12 5 19 12 12 19"
                    class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
                ></polyline>
            </svg>
        </a>
    </nav>
</div>
