---
// BaseLayout.astro
// Document shell for every page: SEO meta (astro-seo), font, theme,
// Header/Drawer/Footer. `title` is the page-specific part only — the site
// name is appended here. Both title and description are required, so
// `astro check` fails the build if a page omits one.
import { Font } from "astro:assets";
import { SEO } from "astro-seo";
import "@styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Drawer from "@components/Drawer.astro";
import { SITE } from "@consts";

interface Props {
  title: string;
  description: string;
  /** Root-relative or absolute URL to a 1200×630 image; defaults to /open-graph.jpg (960×480) */
  ogImage?: string;
  /** Article pages pass "article" */
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogType = "website",
  noindex = false,
} = Astro.props;

const fullTitle = `${title} | ${SITE.TITLE}`;
const ogImageUrl = new URL(ogImage ?? "/open-graph.jpg", Astro.site).href;
const ogImageSize = ogImage ? { width: 1200, height: 630 } : { width: 960, height: 480 };
---

<!doctype html>
<html lang="en" data-theme="mikeyoung">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-body-family" preload />
    <SEO
      title={fullTitle}
      description={description}
      noindex={noindex}
      openGraph={{
        basic: {
          title: fullTitle,
          type: ogType,
          image: ogImageUrl,
        },
        optional: {
          description,
          siteName: SITE.TITLE,
        },
        image: { ...ogImageSize, alt: SITE.TITLE },
      }}
      twitter={{ card: "summary_large_image" }}
      extend={{
        link: [
          { rel: "sitemap", href: "/sitemap-index.xml" },
          {
            rel: "alternate",
            type: "application/rss+xml",
            title: `${SITE.TITLE} — blog and projects`,
            href: new URL("rss.xml", Astro.site).href,
          },
        ],
      }}
    />
    <script is:inline src="/js/theme.js"></script>
    <script is:inline src="/js/scroll.js"></script>
    <script is:inline src="/js/animate.js"></script>
    <script is:inline defer src="/js/copy.js"></script>
  </head>
  <body>
    <a
      href="#main-content"
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60"
    >
      Skip to content
    </a>
    <Header />
    <Drawer />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
