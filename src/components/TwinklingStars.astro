---
/**
 * TwinklingStars.astro
 * The SVG below is a template; the script clones it into #galaxy on an
 * interval and removes each clone after its animation. Colors use
 * currentColor so the star follows the theme's base-content.
 */
---

<svg
  id="twinkle-star"
  class="template text-base-content"
  width="149"
  height="149"
  viewBox="0 0 149 149"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="74" cy="74" r="11" fill="currentColor"></circle>
  <rect y="141.421" width="200" height="10" transform="rotate(-45 0 141.421)" fill="url(#paint0_linear_4_2)"></rect>
  <rect x="7.07107" width="200" height="10" transform="rotate(45 7.07107 0)" fill="url(#paint1_linear_4_2)"></rect>
  <defs>
    <linearGradient id="paint0_linear_4_2" x1="0" y1="146.421" x2="200" y2="146.421" gradientUnits="userSpaceOnUse">
      <stop stop-color="currentColor" stop-opacity="0.12"></stop>
      <stop offset="0.445" stop-color="currentColor"></stop>
      <stop offset="0.58721" stop-color="currentColor"></stop>
      <stop offset="1" stop-color="currentColor" stop-opacity="0.12"></stop>
    </linearGradient>
    <linearGradient id="paint1_linear_4_2" x1="7.07107" y1="5" x2="207.071" y2="5" gradientUnits="userSpaceOnUse">
      <stop stop-color="currentColor" stop-opacity="0.12"></stop>
      <stop offset="0.42" stop-color="currentColor"></stop>
      <stop offset="0.555" stop-color="currentColor"></stop>
      <stop offset="1" stop-color="currentColor" stop-opacity="0.12"></stop>
    </linearGradient>
  </defs>
</svg>

<script>
  function generateTwinkleStar() {
    const template = document.getElementById("twinkle-star");
    const galaxy = document.getElementById("galaxy");
    if (!template || !galaxy) return;

    const star = template.cloneNode(true) as SVGElement;
    star.removeAttribute("id");
    star.classList.remove("template");
    const size =
      window.innerWidth < 768
        ? Math.floor(Math.random() * (15 - 7.5 + 1) + 7.5)
        : Math.floor(Math.random() * (30 - 15 + 1) + 15);
    star.style.position = "absolute";
    star.style.left = Math.floor(Math.random() * window.innerWidth) + "px";
    star.style.top = Math.floor(Math.random() * (window.innerHeight / 3)) + "px";
    star.style.width = size + "px";
    star.style.height = size + "px";
    star.classList.add("animate-twinkle");
    galaxy.appendChild(star);

    setTimeout(() => star.remove(), 2500);
  }

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setInterval(generateTwinkleStar, 5000);
  }
</script>
