---
import { SITE, LINKS } from "@consts";

const { pathname } = Astro.url;
const section = "/" + (pathname.match(/[^/]+/g)?.[0] ?? "");
const isActive = (href: string) => pathname === href || section === href;

const iconButton = [
  "size-9 rounded-full p-2 flex items-center justify-center",
  "bg-transparent hover:bg-base-content/5 dark:hover:bg-base-content/20",
  "stroke-current hover:stroke-base-content",
  "border border-base-content/10 dark:border-base-content/25",
  "transition-colors duration-300 ease-in-out",
];
---

<!-- Mobile menu. Opened by the header's menu button; `inert` keeps the
     links out of the tab order while it's collapsed. -->
<div
  id="drawer"
  inert
  class="fixed inset-0 h-0 z-40 overflow-hidden flex flex-col items-center justify-center md:hidden bg-base-200 transition-[height] duration-300 ease-in-out"
>
  <nav aria-label="Mobile" class="flex flex-col items-center space-y-2">
    {
      LINKS.map((LINK) => (
        <a
          href={LINK.HREF}
          aria-current={isActive(LINK.HREF) ? "page" : undefined}
          class:list={[
            "flex items-center justify-center px-3 py-1 rounded-full",
            "text-current hover:text-base-content",
            "hover:bg-base-content/5 dark:hover:bg-base-content/20",
            "transition-colors duration-300 ease-in-out",
            isActive(LINK.HREF) && "pointer-events-none bg-primary text-primary-content",
          ]}
        >
          {LINK.TEXT}
        </a>
      ))
    }
  </nav>

  <div class="flex gap-1 mt-5">
    <a
      href="/search"
      aria-label={`Search blog posts and projects on ${SITE.TITLE}`}
      aria-current={isActive("/search") ? "page" : undefined}
      class:list={[
        iconButton,
        isActive("/search") && "pointer-events-none bg-primary text-primary-content",
      ]}
    >
      <svg class="size-full" aria-hidden="true">
        <use href="/ui.svg#search"></use>
      </svg>
    </a>

    <button type="button" data-theme-toggle aria-label="Toggle light and dark theme" class:list={iconButton}>
      <svg class="block dark:hidden size-full" aria-hidden="true">
        <use href="/ui.svg#sun"></use>
      </svg>
      <svg class="hidden dark:block size-full" aria-hidden="true">
        <use href="/ui.svg#moon"></use>
      </svg>
    </button>
  </div>
</div>
