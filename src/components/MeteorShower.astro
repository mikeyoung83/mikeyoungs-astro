---
/**
 * MeteorShower.astro
 * Appends meteors to one of four diagonal "shower" containers on an
 * interval; each is removed once its animation finishes. Rotations and the
 * meteor style live in global.css.
 */
---

<div id="meteors" aria-hidden="true">
  <div class="shower ur"></div>
  <div class="shower dr"></div>
  <div class="shower dl"></div>
  <div class="shower ul"></div>
</div>

<script>
  function createMeteor() {
    const meteor = document.createElement("div");
    meteor.setAttribute("class", "meteor");
    meteor.style.left = Math.round(Math.random() * window.innerWidth) + "px";
    meteor.style.top = Math.round(Math.random() * window.innerHeight) + "px";

    const showers = document.querySelectorAll(".shower");
    if (showers.length > 0) {
      showers[Math.floor(Math.random() * showers.length)].append(meteor);
    }

    setTimeout(() => meteor.remove(), 3500);
  }

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setInterval(createMeteor, 1500);
  }
</script>
