---
import { SITE, LINKS } from "@consts";
import Container from "@components/Container.astro";

const { pathname } = Astro.url;
const section = "/" + (pathname.match(/[^/]+/g)?.[0] ?? "");
const isActive = (href: string) => pathname === href || section === href;

const iconButton = [
  "size-9 rounded-full p-2 items-center justify-center",
  "bg-transparent hover:bg-base-content/5 dark:hover:bg-base-content/20",
  "stroke-current hover:stroke-base-content",
  "border border-base-content/10 dark:border-base-content/25",
  "transition-colors duration-300 ease-in-out",
];
---

<header id="header" class="fixed top-0 w-full h-16 z-50">
  <Container size="md">
    <div class="relative h-full w-full">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 flex gap-1 font-semibold">
        <a
          href="/"
          class="flex gap-1 text-current hover:text-base-content transition-colors duration-300 ease-in-out"
        >
          <svg class="size-6 fill-current" aria-hidden="true">
            <use href="/brand.svg#brand"></use>
          </svg>
          <div>{SITE.TITLE}</div>
        </a>
      </div>

      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <nav aria-label="Main" class="hidden md:flex items-center justify-center text-sm gap-1">
          {
            LINKS.map((LINK) => (
              <a
                href={LINK.HREF}
                target={LINK.NEW_TAB ? "_blank" : undefined}
                aria-current={isActive(LINK.HREF) ? "page" : undefined}
                class:list={[
                  "h-8 rounded-full px-3 text-current",
                  "flex items-center justify-center",
                  "transition-colors duration-300 ease-in-out",
                  isActive(LINK.HREF)
                    ? "bg-primary text-primary-content"
                    : "hover:bg-base-content/5 dark:hover:bg-base-content/20 hover:text-base-content",
                ]}
              >
                {LINK.TEXT}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="buttons absolute right-0 top-1/2 -translate-y-1/2 flex gap-1">
        <a
          href="/search"
          aria-label={`Search blog posts and projects on ${SITE.TITLE}`}
          aria-current={isActive("/search") ? "page" : undefined}
          class:list={[
            "hidden md:flex",
            iconButton,
            isActive("/search") && "pointer-events-none bg-primary text-primary-content",
          ]}
        >
          <svg class="size-full" aria-hidden="true">
            <use href="/ui.svg#search"></use>
          </svg>
        </a>

        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle light and dark theme"
          class:list={["hidden md:flex", iconButton]}
        >
          <svg class="size-full block dark:hidden" aria-hidden="true">
            <use href="/ui.svg#sun"></use>
          </svg>
          <svg class="size-full hidden dark:block" aria-hidden="true">
            <use href="/ui.svg#moon"></use>
          </svg>
        </button>

        <button
          type="button"
          id="header-drawer-button"
          aria-label="Open menu"
          aria-controls="drawer"
          aria-expanded="false"
          class:list={["group flex md:hidden", iconButton]}
        >
          <svg class="size-full block group-aria-expanded:hidden" aria-hidden="true">
            <use href="/ui.svg#menu"></use>
          </svg>
          <svg class="size-full hidden group-aria-expanded:block" aria-hidden="true">
            <use href="/ui.svg#x"></use>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<script>
  const drawer = document.getElementById("drawer");
  const drawerButton = document.getElementById("header-drawer-button");

  function setDrawer(open: boolean) {
    drawer?.classList.toggle("h-full", open);
    drawer?.toggleAttribute("inert", !open);
    drawerButton?.setAttribute("aria-expanded", String(open));
    drawerButton?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  }

  drawerButton?.addEventListener("click", () => {
    setDrawer(drawerButton.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && drawerButton?.getAttribute("aria-expanded") === "true") {
      setDrawer(false);
      drawerButton.focus();
    }
  });
</script>
