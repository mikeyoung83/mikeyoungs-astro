---
interface Props {
  text: string;
  icon: string;
  href: string;
}

const { text, icon, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="w-fit px-3 py-2 group rounded-sm border flex gap-2 items-center border-base-content/15 dark:border-base-content/25 hover:bg-base-200 dark:hover:bg-base-300 blend"
>
  <svg height={20} width={20} aria-hidden="true">
    <use href={`/stack.svg#${icon}`}></use>
  </svg>
  <span class="text-sm capitalize text-base-content/60 group-hover:text-base-content blend">
    {text}
  </span>
</a>
