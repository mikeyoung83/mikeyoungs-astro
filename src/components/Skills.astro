---
// Grouped skills list (label → items), from the `skills` collection.
import { getCollection } from "astro:content";

interface Props {
  heading?: string;
}

const { heading = "Skills" } = Astro.props;
const groups = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
---

<div class="space-y-4">
  <h2 class="font-semibold text-base-content">{heading}</h2>
  <dl class="grid grid-cols-1 sm:grid-cols-[11rem_1fr] gap-x-4 gap-y-1 sm:gap-y-3 text-sm">
    {
      groups.map((group) => (
        <>
          <dt class="font-semibold text-base-content mt-2 sm:mt-0">{group.data.label}</dt>
          <dd>{group.data.items.join(" · ")}</dd>
        </>
      ))
    }
  </dl>
</div>
