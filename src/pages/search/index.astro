---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import SiteSearch from "@components/SiteSearch.astro";
import { SEARCH } from "@consts";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
const projects = (await getCollection("projects")).filter((project) => !project.data.draft);
---

<BaseLayout title={SEARCH.META_TITLE} description={SEARCH.META_DESCRIPTION}>
  <TopLayout>
    <h1 class="animate font-semibold text-base-content">
      {SEARCH.TITLE}
    </h1>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <SiteSearch entries={[...posts, ...projects]} />
    </div>
  </BottomLayout>
</BaseLayout>
